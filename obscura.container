[Unit]
Description=Obscura headless browser for mine
StartLimitIntervalSec=0

[Container]
ContainerName=obscura
Image=docker.io/h4ckf0r0day/obscura:latest
Pull=always
PublishPort=127.0.0.1:9222:9222
Environment=OBSCURA_NAV_TIMEOUT_MS=50000
# --host 0.0.0.0 is required inside the container; PublishPort keeps it loopback-only.
Exec=serve --host 0.0.0.0 --stealth

[Service]
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
