{
  "name": "mine",
  "version": "0.3.0",
  "description": "Web fetch for Pi — stealth-rendered pages via patchright-driven branded Chrome (headed, xvfb) to clean markdown via Playwright and Defuddle",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "prepare": "husky"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "defuddle": "^0.19.5",
    "linkedom": "^0.18.13",
    "playwright-core": "~1.64.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.ts": "biome check --write"
  }
}
