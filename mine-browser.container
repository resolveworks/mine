[Unit]
Description=Stealth Chrome browser server for mine
StartLimitIntervalSec=0

[Container]
ContainerName=mine-browser
Image=ghcr.io/resolveworks/mine-browser:latest
Pull=always
PublishPort=127.0.0.1:9222:9222
ShmSize=2g

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=10min

[Install]
WantedBy=default.target
